# Copy to .env and fill in. Docker Compose reads .env from this folder.
# Copie para .env e preencha. O Docker Compose lê o .env desta pasta.

# Hugging Face token used to generate answers through Inference Providers.
# Without it the app still searches and reranks, and shows the sources only.
# Token do Hugging Face usado para gerar respostas via Inference Providers.
# Sem ele o app continua buscando e reordenando, e mostra apenas as fontes.
HF_TOKEN=

# auto | hf_api | openai | local | none
LLM_BACKEND=auto

# Model id. Empty = the notebook model (Qwen/Qwen2.5-14B-Instruct) with fallbacks.
# Id do modelo. Vazio = o modelo do notebook (Qwen/Qwen2.5-14B-Instruct) com alternativas.
LLM_MODEL=

# Any OpenAI-compatible server, for example Ollama on the host:
# Qualquer servidor compatível com OpenAI, por exemplo o Ollama no host:
#   LLM_BACKEND=openai
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=

# auto | cpu | cuda
DEVICE=auto

# Retrieval defaults. Empty = values saved by the notebook (100 reranked on GPU, 40 on CPU; 6 sources; 400 tokens).
# Padrões de recuperação. Vazio = valores salvos pelo notebook.
RAG_N_RETRIEVE=
RAG_N_CONTEXT=
RAG_MAX_NEW_TOKENS=

# Log one MLflow trace per question / registrar um trace do MLflow por pergunta
MLFLOW_TRACE_QUERIES=true

# Host ports, change them if 8501 or 5000 are taken / portas no host, troque se 8501 ou 5000 estiverem ocupadas
APP_PORT=8501
MLFLOW_PORT=5000
